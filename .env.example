# Copy to .env and change the password. .env is gitignored; this file is not.
POSTGRES_USER=opendispatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opendispatch

# The API reads this. "db" is the compose service name.
DATABASE_URL=postgresql://opendispatch:change-me@db:5432/opendispatch

APP_ENV=local

# Who may create a new company. first-run = only the first person, then sign-up closes
# (right for one contractor's own server). open = anyone (a hosted service, or local demo
# seeding, which makes a new company each run). closed = nobody; owners add their people.
SIGNUP=first-run

# SMS budget alerts (optional). Leave blank and alerts are written to the API log instead.
# From https://console.twilio.com. Owners also need a phone on their account and
# "sms_alerts_enabled" turned on for the company (PATCH /company).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email for password resets (optional). Leave SMTP_HOST blank and reset links are written
# to the API log instead, which is fine for local use. Any SMTP provider works.
# Port 465 uses TLS from the start; other ports upgrade with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=OpenDispatch <no-reply@example.com>
# Where people open the web app; reset links in emails point here.
APP_BASE_URL=http://localhost:5173

# The launch waitlist at /waitlist. "closed" (the default) turns every waitlist route off,
# which is what you want: your server runs your business, and the waitlist collects signups
# for the OpenDispatch launch. Only the project's own server sets "open".
WAITLIST=closed
# Needed in the X-Waitlist-Token header to read the list (GET /waitlist). Blank means
# nobody can read it: a signup has no company, so there is no owner to trust with it.
WAITLIST_ADMIN_TOKEN=
# Printed on the public page as the launch window, so it can move without a code change.
LAUNCH_LABEL=Winter 2027
WAITLIST_LIMIT_PER_HOUR=3

# Online booking spam control. Bookings one IP address can send per hour, across every
# company's /book link.
BOOKING_LIMIT_PER_HOUR=5
# Sign-in protection, per IP address across every account. Only wrong passwords count
# toward the login limit, so a whole office signing in from one address is fine.
LOGIN_FAILURES_PER_15_MINUTES=10
SIGNUP_LIMIT_PER_HOUR=5
RESET_LIMIT_PER_HOUR=5
# Proxies in front of the API that add to X-Forwarded-For (a load balancer, a hosting
# front end). 0 = none. Set it to exactly how many there are: too high lets people dodge
# the limit, too low puts everyone in one shared limit. docker-compose.yml sets 1 for the
# API, because browsers reach it through the web service's proxy.
TRUSTED_PROXY_HOPS=0

# Technician job links: the signed /j/<token> link in a calendar event that opens the job
# with no login. Nothing about a link is stored, so this secret is what makes one real:
# set it to a long random string, and know that changing it invalidates every link
# already out there. Left blank, links work locally (APP_ENV=local uses a built-in dev
# key) and are turned off anywhere else, so events still go out, just without a link.
JOB_LINK_SECRET=
# How long a link lasts past the job's scheduled time.
JOB_LINK_TTL_HOURS=72

# Google Calendar (optional). Leave GOOGLE_REFRESH_TOKEN blank and calendar changes are
# written to the API log instead, which is all you need locally. These belong to the
# Google account whose calendar the jobs go on; the README says how to get the refresh
# token. Technicians are invited as attendees, so they need no Google account of their own.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# "primary" is that account's own calendar; otherwise a calendar id (an email address).
GOOGLE_CALENDAR_ID=primary
# How long a job blocks out on a calendar. Jobs have a start time but no end yet.
DEFAULT_JOB_MINUTES=120

# Google Sheets (optional), and only for the launch waitlist above: a copy of every signup
# in a spreadsheet, so the people running the launch can read and sort the list without
# the API. Leave GOOGLE_SHEETS_ID blank and the rows are written to the API log instead,
# which is right for every install that isn't taking signups.
# The spreadsheet has to exist already, be shared with the Google account below as an
# editor, and have a tab named GOOGLE_SHEETS_TAB. Its id is the long part of its URL:
# docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Waitlist
# Sheets needs the .../auth/spreadsheets scope, which GOOGLE_REFRESH_TOKEN above only has
# if it was consented with both scopes. Leave this blank to reuse that token; set it to
# use a separate one for Sheets. Same GOOGLE_CLIENT_ID/SECRET either way.
GOOGLE_SHEETS_REFRESH_TOKEN=

# How often the worker looks for failed calendar and spreadsheet writes to retry, when it
# has nothing else to do.
OUTBOX_POLL_SECONDS=30
