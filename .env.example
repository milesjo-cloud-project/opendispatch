# Copy to .env and change the password. .env is gitignored; this file is not.
POSTGRES_USER=opendispatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opendispatch

# The API reads this. "db" is the compose service name.
DATABASE_URL=postgresql://opendispatch:change-me@db:5432/opendispatch

APP_ENV=local

# SMS budget alerts (optional). Leave blank and alerts are written to the API log instead.
# From https://console.twilio.com. Owners also need a phone on their account and
# "sms_alerts_enabled" turned on for the company (PATCH /company).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
